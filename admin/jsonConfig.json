{
    "i18n": true,
    "type": "tabs",
    "items": {
        "tabLogin": {
            "type": "panel",
            "label": "Login",
            "items": {
                "_introLogin": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "The adapter retrieves local credentials (GroupID/GroupKey) once by signing in with your Miele account. The Miele app continues to work as before. No credentials are transmitted to third parties.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "country": {
                    "type": "select",
                    "label": "Country",
                    "newLine": true,
                    "options": [
                        {
                            "label": "Germany",
                            "value": "de"
                        },
                        {
                            "label": "Austria",
                            "value": "at"
                        },
                        {
                            "label": "Switzerland",
                            "value": "ch"
                        },
                        {
                            "label": "Netherlands",
                            "value": "nl"
                        },
                        {
                            "label": "France",
                            "value": "fr"
                        },
                        {
                            "label": "Italy",
                            "value": "it"
                        },
                        {
                            "label": "Spain",
                            "value": "es"
                        },
                        {
                            "label": "United Kingdom",
                            "value": "gb"
                        },
                        {
                            "label": "Denmark",
                            "value": "dk"
                        },
                        {
                            "label": "Sweden",
                            "value": "se"
                        },
                        {
                            "label": "Poland",
                            "value": "pl"
                        },
                        {
                            "label": "Czechia",
                            "value": "cz"
                        },
                        {
                            "label": "USA",
                            "value": "us"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "region": {
                    "type": "select",
                    "label": "Cloud region",
                    "options": [
                        {
                            "label": "Europe (EU)",
                            "value": "EU"
                        },
                        {
                            "label": "Europe (EU2)",
                            "value": "EU2"
                        },
                        {
                            "label": "Asia (AS)",
                            "value": "AS"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_step1": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "Step 1: Click \"Open login page\" and sign in with your Miele account in the browser. At the end the browser tries to open an address of the form \"miele://oauth2-code/?code=…&state=…\". This complete address (the \"code\") is needed in step 2.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "openLogin": {
                    "type": "sendTo",
                    "label": "Open login page",
                    "command": "getAuthUrl",
                    "jsonData": "{ \"country\": \"${data.country}\" }",
                    "openUrl": true,
                    "variant": "contained",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_step1Header": {
                    "type": "header",
                    "text": "Step 1: Prepare browser developer tools",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_step1Text": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "1. Click 'Open login page' above (a new browser tab opens).\n2. In the new tab, press F12 and switch to the 'Network' tab.\n3. Enable persistent logging:\n   • Chrome / Edge / Brave: Check 'Preserve log'.\n   • Firefox: Click gear ⚙️ ➔ check 'Persist Logs'.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_step2Header": {
                    "type": "header",
                    "text": "Step 2: Sign in with Miele",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_step2Text": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "1. Enter your Miele app account email and password and click 'Sign in'.\n2. Note: After login, the page will hang on a spinning loading wheel (or show an error). This is completely normal and indicates success!",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_step3Header": {
                    "type": "header",
                    "text": "Step 3: Copy redirect address & fetch GroupKey",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_step3Text": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "1. In the Network tab (F12), scroll to the very last (often red) request starting with 'redirect?redirect_uri=miele...' or 'miele://oauth2-code/...'.\n2. Right-click that entry ➔ 'Copy URL' / 'Copy link address'.\n3. Paste the URL into the field below and click 'Fetch GroupKey'.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "redirectUrl": {
                    "type": "text",
                    "label": "miele:// redirect URL",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "fetchKey": {
                    "type": "sendTo",
                    "label": "Fetch GroupKey",
                    "command": "submitRedirect",
                    "jsonData": "{ \"redirectUrl\": \"${data.redirectUrl}\", \"region\": \"${data.region}\" }",
                    "variant": "contained",
                    "useNative": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_status": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "Once retrieved, GroupID and encrypted GroupKey appear on the 'Advanced' tab. Don't forget to save.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "tabDevices": {
            "type": "panel",
            "label": "Appliances",
            "items": {
                "autoDiscover": {
                    "type": "checkbox",
                    "label": "Find devices automatically via mDNS",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Finds appliances via mDNS on the same network. Multicast does not pass through a Docker bridge network – then enter the IP addresses below by hand."
                },
                "autoDiscoverInterval": {
                    "type": "number",
                    "label": "Background discovery interval in minutes",
                    "min": 1,
                    "max": 120,
                    "default": 10,
                    "hidden": "!data.autoDiscover",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "discoverNow": {
                    "type": "sendTo",
                    "label": "Search now",
                    "command": "discover",
                    "variant": "outlined",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "ipFallbackScan": {
                    "type": "checkbox",
                    "label": "Search the subnet for the new IP if a device drops out",
                    "help": "If a manually entered device stops answering, the adapter probes its own /24 network once (at most every 30 minutes). Needed when the appliances get their IP via DHCP and mDNS does not get through - for instance inside a Docker bridge network.",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "devices": {
                    "type": "table",
                    "label": "Manual device IPs (optional, additional)",
                    "newLine": true,
                    "items": [
                        {
                            "type": "text",
                            "attr": "ip",
                            "title": "IP address",
                            "width": "100%"
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "help": "For appliances the scan does not find, and whenever multicast does not get through. One row per appliance."
                }
            }
        },
        "tabValues": {
            "type": "panel",
            "label": "Polling & values",
            "items": {
                "pollInterval": {
                    "type": "number",
                    "label": "Poll interval (idle) in seconds",
                    "newLine": true,
                    "default": 30,
                    "min": 5,
                    "max": 3600,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "How often the adapter polls while no programme is running."
                },
                "activePollInterval": {
                    "type": "number",
                    "label": "Poll interval (active) in seconds",
                    "default": 30,
                    "min": 5,
                    "max": 600,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "How often the adapter polls while a programme is running."
                },
                "germanNames": {
                    "type": "checkbox",
                    "label": "State names in German",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "help": "Creates the state names bilingually; the admin then shows them in German. Takes effect after saving and restarting."
                },
                "secondsTime": {
                    "type": "checkbox",
                    "label": "Fetch second-precise remaining/elapsed time (DOP2)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Reads remaining and elapsed time to the second via DOP2 instead of only in minutes."
                },
                "secondsInterval": {
                    "type": "number",
                    "label": "Second polling interval in seconds",
                    "min": 10,
                    "max": 3600,
                    "default": 30,
                    "hidden": "!data.secondsTime",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "ecoFeedback": {
                    "type": "checkbox",
                    "label": "Fetch EcoFeedback (energy/water)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Reads energy and water via DOP2. Only appliances that provide it – so far washing machines."
                },
                "ecoInterval": {
                    "type": "number",
                    "label": "EcoFeedback interval in seconds",
                    "min": 15,
                    "max": 3600,
                    "hidden": "!data.ecoFeedback",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "energyMeters": {
                    "type": "table",
                    "label": "Energy meter per appliance (optional)",
                    "newLine": true,
                    "items": [
                        {
                            "type": "text",
                            "attr": "serial",
                            "title": "Appliance serial number",
                            "width": "40%"
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "Meter datapoint (Wh, monotonically increasing)",
                            "width": "60%"
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "help": "The consumption reported by the appliance is an estimate, not a measurement. If you have a metering plug in front of it, enter its meter state here."
                },
                "leafStates": {
                    "type": "checkbox",
                    "newLine": true,
                    "label": "Create what the device delivers",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Creates the appliance's internal values as states – heating relay, water level, drum speed and more. The field names come from public projects and are unverified."
                }
            }
        },
        "tabPush": {
            "type": "panel",
            "label": "Push & ports",
            "items": {
                "usePush": {
                    "type": "checkbox",
                    "label": "Enable SuperVision push (experimental, real-time)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "help": "Appliances report changes immediately instead of being polled. Not every module can do this: older XKM accept the subscription but send nothing."
                },
                "pushPort": {
                    "type": "number",
                    "label": "Inbound push port (TCP)",
                    "min": 1024,
                    "max": 65535,
                    "hidden": "!data.usePush",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Must be reachable inbound from the appliance network. In a Docker container this reliably works only with network_mode: host."
                }
            }
        },
        "tabControl": {
            "type": "panel",
            "label": "Control",
            "items": {
                "allowControl": {
                    "type": "checkbox",
                    "label": "Enable control (write commands)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "help": "Creates writable states. Commands only take effect while MobileStart is enabled on the appliance; some firmwares reject them outright."
                }
            }
        },
        "tabHistory": {
            "type": "panel",
            "label": "History",
            "items": {
                "cycleHistory": {
                    "type": "checkbox",
                    "label": "Record cycles",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "help": "Records every completed programme. The appliances keep nothing – the history starts when you switch this on and cannot be filled retroactively."
                },
                "cycleRingSize": {
                    "type": "number",
                    "label": "Entries in the ring buffer",
                    "help": "How many recent cycles are kept in cyclesJson. Meant for quick display; long-term data comes from the history adapter.",
                    "min": 1,
                    "max": 1000,
                    "default": 50,
                    "hidden": "!data.cycleHistory",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "historyDays": {
                    "type": "number",
                    "label": "Retention in days",
                    "help": "Older entries drop out of the ring buffer. 730 days is two years.",
                    "min": 1,
                    "max": 3650,
                    "default": 730,
                    "hidden": "!data.cycleHistory",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "historyWrite": {
                    "type": "checkbox",
                    "label": "Also write to the history adapter",
                    "help": "Energy, water and duration per cycle, timestamped at the end of the cycle – so charts can cover any period.",
                    "newLine": true,
                    "hidden": "!data.cycleHistory",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "historyInstance": {
                    "type": "instance",
                    "adapter": "history",
                    "label": "History instance",
                    "allowDeactivate": false,
                    "default": "history.0",
                    "hidden": "!data.cycleHistory || !data.historyWrite",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "tabDiagnostics": {
            "type": "panel",
            "label": "Diagnostics",
            "items": {
                "_diagnosticsIntro": {
                    "type": "staticText",
                    "newLine": true,
                    "text": "These settings serve troubleshooting and field mapping. They are not needed for daily operation and are off by default. Collected data stays in this instance.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "ecoRawFields": {
                    "type": "checkbox",
                    "label": "Record raw fields (diagnostics only)",
                    "newLine": true,
                    "hidden": "!data.ecoFeedback",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Writes all fields of the eco leaf to eco.fieldsJson instead of only the two evaluated ones. Helps when energy or water arrive wrong on your model."
                },
                "_collectorHeader": {
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "type": "header",
                    "size": 4,
                    "newLine": true,
                    "text": "Data collection for other models"
                },
                "collectorActive": {
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "type": "checkbox",
                    "newLine": true,
                    "label": "Collect datasets",
                    "help": "Records one dataset per programme with model, programme and all raw fields. From cloud values or your own entries the adapter derives the field mapping."
                },
                "leafScanAuto": {
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "type": "checkbox",
                    "newLine": true,
                    "label": "Start the leaf search when a device is switched on",
                    "help": "Only for devices whose search has never run. A device that is off most of the time would otherwise never be searched. The search only reads, and stops as soon as the device is off again."
                },
                "collectorCloud": {
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "type": "checkbox",
                    "newLine": true,
                    "hidden": "!data.collectorActive",
                    "label": "Include cloud values for comparison",
                    "help": "Requires a running instance of the mielecloudservice adapter."
                },
                "collectorCloudInstance": {
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "type": "text",
                    "newLine": true,
                    "hidden": "!data.collectorCloud",
                    "label": "Cloud adapter instance",
                    "default": "mielecloudservice.0",
                    "help": "Instance of the cloud adapter the reference values come from, for example mielecloudservice.0."
                },
                "_collectorManual": {
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "type": "staticText",
                    "newLine": true,
                    "hidden": "!data.collectorActive",
                    "text": "Without cloud: after each programme, enter energy and water from the Miele app into \"collection.inputEnergy\" and \"collection.inputWater\" - they are attached to the most recent dataset. \"collection.progress\" shows what is still missing."
                },
                "_csvHeader": {
                    "type": "header",
                    "size": 4,
                    "newLine": true,
                    "text": "Export collected data",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "csvExport": {
                    "type": "sendTo",
                    "command": "csvExport",
                    "openUrl": true,
                    "newLine": true,
                    "label": "Create and open CSV",
                    "variant": "contained",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Writes two tables and opens the first: one row per programme with all raw fields, plus an analysis with one row per field. Take care when sharing – the table contains the programme timestamps."
                },
                "ecoEnergyIdx": {
                    "type": "number",
                    "label": "Energy field index",
                    "min": 1,
                    "max": 200,
                    "default": 25,
                    "newLine": true,
                    "hidden": "!data.ecoFeedback",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2,
                    "help": "Number of the field in the eco leaf that carries the energy. The default fits the WCR860; on other models determine it via the data collection."
                },
                "ecoWaterIdx": {
                    "type": "number",
                    "label": "Water field index",
                    "min": 1,
                    "max": 200,
                    "default": 21,
                    "hidden": "!data.ecoFeedback",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2,
                    "help": "Number of the field in the eco leaf that carries the water volume. The default fits the WCR860; on other models determine it via the data collection."
                },
                "ecoWaterDiv": {
                    "type": "number",
                    "label": "Water field divisor",
                    "help": "Raw value ÷ divisor = litres",
                    "min": 1,
                    "max": 100000,
                    "step": 0.01,
                    "default": 200,
                    "hidden": "!data.ecoFeedback",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "tabAdvanced": {
            "type": "panel",
            "label": "Advanced",
            "items": {
                "groupId": {
                    "type": "text",
                    "label": "GroupID (16 hex chars)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "help": "Normally set through the login. Enter by hand only if GroupID and GroupKey are already known."
                },
                "groupKey": {
                    "type": "password",
                    "label": "GroupKey (128 hex chars)",
                    "visible": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "help": "Stored encrypted and never shown in clear text."
                }
            }
        }
    }
}
